#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/softbank/nao/protos/Nao.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/Floor.proto"

WorldInfo {
  info [
    "Pose imitation of human motion by a simulated humanoid robot (NAO H25)."
    "Real time: MeTRAbs 3D pose (GPU) -> UDP 8765 -> pose_imitation_controller."
    ""
    "DO NOT REMOVE THE contactProperties NODE BELOW - it is not cosmetic."
    "Nao.proto tags its soles with the contact material 'NAO foot material'."
    "With no matching ContactProperties the sole/floor pair silently falls back"
    "to Webots' default contact (coulombFriction 1, bouncy), so the feet SLIDE"
    "and JITTER: the robot cannot load one foot, cannot take a step, and the leg"
    "controller LOOKS FROZEN because every leg command is absorbed by foot slip."
    "The values here match Cyberbotics' own NAO worlds (friction 8, no bounce)."
    ""
    "basicTimeStep must stay at 20 ms or less. Webots' default of 32 ms is too"
    "coarse for NAO leg control and destabilises the pre-balanced .motion walk"
    "clips; the controller logs a warning if it finds a larger value."
    ""
    "The floor is 20 x 20 m because the robot really translates when the human"
    "walks, and the Viewpoint follows 'NAO' so the camera does not lose it."
  ]
  basicTimeStep 20
  contactProperties [
    ContactProperties {
      material2 "NAO foot material"
      coulombFriction [
        8
      ]
      bounce 0
      bounceVelocity 0.003
    }
  ]
}
Viewpoint {
  orientation 0.02860952101842819 -0.01070769781337589 0.9995333113581725 3.0934870340474974
  position 2.132546942267732 -0.09997433988663172 0.3005749931473203
  follow "NAO"
}
Floor {
  size 20 20
  tileSize 1 1
}
Nao {
  controller "pose_imitation_controller"
  # Needed only so the controller can stand the robot back up by itself
  # after a fall (Supervisor.simulationReset). Without it the controller
  # still DETECTS the fall -- head height above the soles needs no
  # privileges -- but can only ask you to press Ctrl+Shift+R. Nothing else
  # in this project uses supervisor powers: the balance loop is
  # deliberately model-based precisely so that it does not need them.
  supervisor TRUE
}
TexturedBackground {
}
TexturedBackgroundLight {
}
